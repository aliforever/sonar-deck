import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <color> tint: Theme.text;
    in property <length> size: 20px;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 2px;
    fill: transparent;
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000070;
}

export component Label inherits Text {
    color: Theme.dim;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

// Rounded button with an optional icon; `active` fills it with the accent.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <color> accent: Theme.accent;
    in property <length> pad: 16px;
    callback clicked;
    height: 38px;
    border-radius: self.height / 2;
    background: active ? @linear-gradient(90deg, accent 0%, accent.brighter(0.25) 100%) : (ta.has-hover ? #ffffff16 : #ffffff0a);
    border-width: 1px;
    border-color: active ? accent.brighter(0.4) : Theme.line;
    drop-shadow-blur: active ? 18px : 0px;
    drop-shadow-color: accent.with-alpha(0.45);
    animate background, drop-shadow-blur { duration: 180ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 8px;
        Rectangle { horizontal-stretch: 1; }
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { commands: root.icon; size: 16px; tint: root.active ? #ffffff : Theme.text; }
        }
        Text {
            text: root.text;
            color: root.active ? #ffffff : Theme.text;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle { horizontal-stretch: 1; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active;
    in property <color> accent: Theme.bad;
    callback clicked;
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: active ? accent.with-alpha(0.22) : (ta.has-hover ? #ffffff18 : #ffffff0c);
    border-width: 1px;
    border-color: active ? accent : Theme.line;
    animate background, border-color { duration: 150ms; }
    Icon { commands: root.icon; size: 18px; tint: root.active ? root.accent : Theme.text; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    height: 44px;
    border-radius: 12px;
    background: active ? #ff5a1f22 : (ta.has-hover ? #ffffff0c : transparent);
    animate background { duration: 150ms; }
    Rectangle {
        x: 0;
        width: 3px;
        height: root.active ? 22px : 0px;
        border-radius: 2px;
        background: Theme.accent;
        animate height { duration: 200ms; easing: ease-out; }
    }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 12px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon { commands: root.icon; size: 18px; tint: root.active ? Theme.accent : Theme.dim; }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.active ? Theme.text : Theme.dim;
            font-size: 14px;
            font-weight: root.active ? 700 : 500;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Vertical fader. Shows the drag position while pressed, the model value otherwise.
export component Fader inherits Rectangle {
    in property <float> value;
    // Live signal level (0..1), drawn beside the track.
    in property <float> level;
    in property <color> accent: Theme.accent;
    in property <bool> muted;
    callback moved(float);
    property <float> drag;
    property <float> shown: ta.pressed ? drag : value;
    property <color> tone: muted ? #59607066 : accent;
    width: 46px;
    min-height: 120px;

    track := Rectangle {
        x: (parent.width - 10px) / 2;
        width: 10px;
        border-radius: 5px;
        background: #ffffff0f;
        border-width: 1px;
        border-color: #ffffff08;
    }
    Rectangle {
        x: track.x;
        width: 10px;
        y: parent.height * (1 - root.shown);
        height: parent.height * root.shown;
        border-radius: 5px;
        background: @linear-gradient(0deg, root.tone.darker(0.45) 0%, root.tone 100%);
        drop-shadow-blur: root.muted ? 0px : 14px;
        drop-shadow-color: root.accent.with-alpha(0.55);
    }
    Rectangle {
        x: track.x + 16px;
        width: 4px;
        y: parent.height * (1 - min(1, root.level));
        height: parent.height * min(1, root.level);
        border-radius: 2px;
        background: @linear-gradient(0deg, #3ddc97 0%, #ffc53d 75%, #ff4d6d 100%);
        opacity: root.level > 0.005 ? 1 : 0;
    }
    knob := Rectangle {
        width: 34px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: max(0px, min(parent.height - self.height, parent.height * (1 - root.shown) - self.height / 2));
        border-radius: 8px;
        background: ta.pressed ? #ffffff : #e9ecf2;
        border-width: 2px;
        border-color: root.tone;
        drop-shadow-blur: ta.has-hover || ta.pressed ? 16px : 8px;
        drop-shadow-color: root.accent.with-alpha(0.6);
        animate drop-shadow-blur { duration: 150ms; }
        Rectangle { width: 14px; height: 2px; border-radius: 1px; background: root.tone; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.drag = clamp(1 - self.mouse-y / self.height, 0, 1);
                root.moved(root.drag);
            }
        }
        moved => {
            root.drag = clamp(1 - self.mouse-y / self.height, 0, 1);
            root.moved(root.drag);
        }
        scroll-event(e) => {
            root.moved(clamp(root.value + (e.delta-y > 0 ? 0.03 : -0.03), 0, 1));
            accept
        }
    }
}

// Horizontal slider in the same style, for ChatMix and hardware volume.
export component HSlider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <color> accent: Theme.accent;
    in property <color> accent-2: Theme.accent-2;
    in property <bool> centered;
    callback moved(float);
    property <float> drag;
    property <float> shown: ta.pressed ? drag : value;
    property <float> t: (shown - minimum) / (maximum - minimum);
    height: 30px;

    Rectangle {
        y: (parent.height - 8px) / 2;
        height: 8px;
        border-radius: 4px;
        background: root.centered ? @linear-gradient(90deg, root.accent.with-alpha(0.35) 0%, #ffffff10 50%, root.accent-2.with-alpha(0.35) 100%) : #ffffff10;
    }
    if !root.centered: Rectangle {
        x: 0;
        y: (parent.height - 8px) / 2;
        height: 8px;
        width: parent.width * root.t;
        border-radius: 4px;
        background: @linear-gradient(90deg, root.accent.darker(0.3) 0%, root.accent 100%);
    }
    Rectangle {
        width: 22px;
        height: 22px;
        y: (parent.height - self.height) / 2;
        x: max(0px, min(parent.width - self.width, parent.width * root.t - self.width / 2));
        border-radius: 11px;
        background: #ffffff;
        border-width: 3px;
        border-color: root.centered && root.t > 0.5 ? root.accent-2 : root.accent;
        drop-shadow-blur: 12px;
        drop-shadow-color: root.accent.with-alpha(0.6);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.drag = root.minimum + clamp(self.mouse-x / self.width, 0, 1) * (root.maximum - root.minimum);
                root.moved(root.drag);
            }
        }
        moved => {
            root.drag = root.minimum + clamp(self.mouse-x / self.width, 0, 1) * (root.maximum - root.minimum);
            root.moved(root.drag);
        }
        scroll-event(e) => {
            root.moved(clamp(root.value + (e.delta-y > 0 ? 0.05 : -0.05) * (root.maximum - root.minimum), root.minimum, root.maximum));
            accept
        }
    }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.good;
    height: 24px;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: tone.with-alpha(0.14);
    border-width: 1px;
    border-color: tone.with-alpha(0.4);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 7px; height: 7px; border-radius: 4px; background: root.tone; }
        }
        Text { text: root.text; color: root.tone.brighter(0.2); font-size: 11px; font-weight: 700; vertical-alignment: center; }
    }
}

export component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <color> accent: Theme.accent;
    callback toggled(bool);
    width: 44px;
    height: 24px;
    border-radius: 12px;
    background: checked ? accent : #ffffff1a;
    border-width: 1px;
    border-color: checked ? accent.brighter(0.3) : Theme.line;
    drop-shadow-blur: checked ? 12px : 0px;
    drop-shadow-color: accent.with-alpha(0.45);
    animate background, drop-shadow-blur { duration: 160ms; }
    Rectangle {
        width: 18px;
        height: 18px;
        y: 3px;
        x: root.checked ? root.width - 21px : 3px;
        border-radius: 9px;
        background: #ffffff;
        drop-shadow-blur: 6px;
        drop-shadow-color: #00000060;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.toggled(!root.checked); } }
}

// Thin horizontal level meter.
export component LevelBar inherits Rectangle {
    in property <float> level;
    height: 4px;
    border-radius: 2px;
    background: #ffffff0d;
    Rectangle {
        x: 0;
        width: parent.width * min(1, root.level);
        border-radius: 2px;
        background: @linear-gradient(90deg, #3ddc97 0%, #ffc53d 75%, #ff4d6d 100%);
    }
}

// Letter avatar for apps.
export component Avatar inherits Rectangle {
    in property <string> text;
    in property <color> tone;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: tone.with-alpha(0.22);
    border-width: 1px;
    border-color: tone.with-alpha(0.5);
    Text { text: root.text; color: root.tone.brighter(0.3); font-weight: 800; font-size: 13px; }
}

// Row of mutually exclusive options.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> index;
    in property <color> accent: Theme.accent;
    callback changed(int);
    height: 34px;
    border-radius: 10px;
    background: #ffffff0a;
    border-width: 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for o[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            border-radius: 8px;
            background: i == root.index ? root.accent : (sta.has-hover ? #ffffff10 : transparent);
            animate background { duration: 140ms; }
            Text {
                text: o;
                color: i == root.index ? #ffffff : Theme.dim;
                font-weight: i == root.index ? 700 : 500;
                font-size: 12px;
            }
            sta := TouchArea { mouse-cursor: pointer; clicked => { root.changed(i); } }
        }
    }
}

// Slider for small integer ranges (1..10) with its value shown.
export component StepSlider inherits HorizontalLayout {
    in property <int> value;
    in property <int> minimum: 1;
    in property <int> maximum: 10;
    in property <color> accent: Theme.accent;
    callback changed(int);
    spacing: 12px;
    HSlider {
        horizontal-stretch: 1;
        value: root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        accent: root.accent;
        moved(v) => {
            if (round(v) != root.value) {
                root.changed(round(v));
            }
        }
    }
    Text { text: root.value; color: Theme.text; font-weight: 700; width: 24px; horizontal-alignment: right; vertical-alignment: center; }
}
